{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "skills/demo/SKILL.md"
                },
                "region": {
                  "endColumn": 49,
                  "endLine": 5,
                  "snippet": {
                    "text": "<SECRET>"
                  },
                  "startColumn": 10,
                  "startLine": 5
                }
              }
            }
          ],
          "message": {
            "text": "github-pat has detected secret for file skills/demo/SKILL.md."
          },
          "partialFingerprints": {
            "author": "",
            "commitMessage": "",
            "commitSha": "",
            "date": "",
            "email": ""
          },
          "properties": {
            "tags": []
          },
          "ruleId": "github-pat"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "name": "gitleaks",
          "rules": [
            {
              "id": "github-pat",
              "shortDescription": {
                "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
              }
            },
            {
              "id": "1password-service-account-token",
              "shortDescription": {
                "text": "Uncovered a possible 1Password service account token, potentially compromising access to secrets in vaults."
              }
            },
            {
              "id": "adafruit-api-key",
              "shortDescription": {
                "text": "Identified a potential Adafruit API Key, which could lead to unauthorized access to Adafruit services and sensitive data exposure."
              }
            }
          ],
          "semanticVersion": "v8.0.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
