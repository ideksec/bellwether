# Bellwether evaluation artifacts (§17.1, §23)
.bellwether-out/

# The committed demo reports (examples/reports/) keep only the rendered outputs —
# summary.json, verdict.json, and report/. The per-run traces and canonical readings are
# bulky and fully regenerable by `bellwether demo`, so they are not committed.
examples/reports/**/traces/
examples/reports/**/canonical/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/
.coverage
htmlcov/

# Materialised corpus payloads — §24 stores these base64-encoded and a build step
# expands them, so the expanded form must never be committed.
tests/corpus/**/_materialized/

# Secrets — never commit real credentials. Bellwether plants *fake* canary credentials
# at runtime (see capture/planting.py) and mints scoped tokens onto the shared proxy
# volume; none of that is committed, and neither should any real key be. `.env.example`
# is the one intentional exception (a committed template with placeholder values).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.local-secrets/

# Editors / OS
.idea/
.vscode/
.DS_Store
