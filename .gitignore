# Bellwether evaluation artifacts (§17.1, §23)
.bellwether-out/

# The committed demo reports (examples/reports/) keep only the rendered outputs —
# summary.json, verdict.json, and report/. The per-run traces and canonical readings are
# bulky and fully regenerable by `bellwether demo`, so they are not committed.
examples/reports/**/traces/
examples/reports/**/canonical/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/
.coverage
htmlcov/

# Materialised corpus payloads — §24 stores these base64-encoded and a build step
# expands them, so the expanded form must never be committed.
tests/corpus/**/_materialized/

# Editors / OS
.idea/
.vscode/
.DS_Store
